          "South_Africa_Ghana"
        ]
      },
      "metadata": {
        "description": "Source-to-destination market corridor. Format is OriginMarket_DestinationMarket. Cross-border corridors have higher fraud rates and require FX settlement. Nigeria_Kenya is highest-volume cross-border corridor.",
        "high_risk_corridors": [
          "Nigeria_South_Africa",
          "Ghana_Nigeria",
          "Kenya_South_Africa"
        ]
      }
    },
    "dim_date_day_of_week": {
      "column_name": "dim_date_day_of_week",
      "table_name": "dim",
      "values": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Day of week for temporal fraud pattern analysis. Fraud spike typically observed Friday\u2013Saturday evenings across all markets."

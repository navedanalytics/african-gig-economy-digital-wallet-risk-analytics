    "dim_market_regulatory_tier": {
      "column_name": "dim_market_regulatory_tier",
      "table_name": "dim",
      "values": [
        "Tier_1",
        "Tier_2",
        "Tier_3"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "KYC compliance tier enforced by local regulator. Tier_1 = basic phone-verified; Tier_2 = ID-verified; Tier_3 = full KYC with biometric. Affects transaction limits and fraud risk exposure."
      }
    },
    "dim_channel_channel_type": {
      "column_name": "dim_channel_channel_type",
      "table_name": "dim",
      "values": [
        "App",
        "USSD",
        "Agent",
        "Web",
        "API"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Primary interface through which the transaction was initiated. USSD and Agent are higher fraud-risk channels due to reduced device fingerprinting. App enables full device-signal capture.",
        "risk_ranking": "Agent > USSD > Web > API > App"
      }
    },
    "dim_channel_channel_subtype": {
      "column_name": "dim_channel_channel_subtype",
      "table_name": "dim",
      "values": [
        "Android_App",
        "iOS_App",
        "USSD_Self_Service",
        "USSD_Agent_Assisted",
        "Agent_Mobile_Money",
        "Agent_POS",
        "Agent_Kiosk",
        "Web_Browser",
        "Web_PWA",
        "API_Partner",
        "API_B2B"
      ],
      "hierarchy": {
        "App": [
          "Android_App",
          "iOS_App"
        ],
        "USSD": [
          "USSD_Self_Service",
          "USSD_Agent_Assisted"
        ],
        "Agent": [
          "Agent_Mobile_Money",
          "Agent_POS",
          "Agent_Kiosk"
        ],
        "Web": [
          "Web_Browser",
          "Web_PWA"
        ],
        "API": [
          "API_Partner",
          "API_B2B"
        ]
      },
      "metadata": {
        "description": "Granular channel subtype for risk segmentation. Agent_Mobile_Money is dominant in Kenya. USSD_Agent_Assisted carries highest reversal rate due to input errors."
      }
    },
    "dim_channel_device_os": {
      "column_name": "dim_channel_device_os",
      "table_name": "dim",
      "values": [
        "Android",
        "iOS",
        "KaiOS",
        "Undetected",
        "N/A"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Operating system of transaction-initiating device. KaiOS associated with feature-phone USSD/App hybrid. N/A applies to Agent and API channels. Undetected is a fraud-signal flag."
      }
    },
    "dim_channel_network_type": {
      "column_name": "dim_channel_network_type",
      "table_name": "dim",
      "values": [
        "2G",
        "3G",
        "4G",
        "5G",
        "WiFi",
        "Offline_Sync",
        "Unknown"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Network connectivity at transaction time. Offline_Sync applies to agent POS batch settlements. Unknown is a risk signal for app transactions."
      }
    },
    "dim_worker_worker_type": {
      "column_name": "dim_worker_worker_type",
      "table_name": "dim",
      "values": [
        "Ride_Hailing_Driver",
        "Delivery_Rider",
        "Freelance_Creative",
        "Market_Trader",
        "Domestic_Worker",
        "Construction_Worker",
        "Street_Vendor"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Gig-economy worker segment. Ride_Hailing_Driver and Delivery_Rider tend to have higher transaction velocity. Market_Trader and Street_Vendor more likely to use USSD or Agent channels.",
        "risk_notes": "Freelance_Creative has highest dispute rate due to service-delivery ambiguity in peer transfers."
      }
    },
    "dim_worker_gender": {
      "column_name": "dim_worker_gender",
      "table_name": "dim",
      "values": [
        "Male",
        "Female",
        "Non_Binary",
        "Not_Disclosed"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Self-reported gender. Used for equity analysis in intervention targeting to avoid disproportionate friction on female workers."
      }
    },
    "dim_worker_account_status": {
      "column_name": "dim_worker_account_status",
      "table_name": "dim",
      "values": [
        "Active",
        "Suspended",
        "Dormant",
        "Closed",
        "Under_Review"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Current account lifecycle state. Suspended and Under_Review accounts may still have in-flight transactions that require resolution. Dormant accounts with sudden high-value activity are a fraud signal."
      }
    },
    "dim_worker_kyc_level": {
      "column_name": "dim_worker_kyc_level",
      "table_name": "dim",
      "values": [
        "Phone_Verified",
        "ID_Verified",
        "Biometric_Verified",
        "Enhanced_Due_Diligence"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "KYC completion level. Maps loosely to regulatory tier. Enhanced_Due_Diligence required for workers with monthly volumes exceeding market-specific thresholds."
      }
    },
    "dim_worker_risk_band": {
      "column_name": "dim_worker_risk_band",
      "table_name": "dim",
      "values": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Internal risk score band assigned by the risk engine. Updated nightly. Critical band workers are subject to transaction holds pending manual review."
      }
    },
    "fact_transactions_transaction_type": {
      "column_name": "fact_transactions_transaction_type",
      "table_name": "fact",
      "values": [
        "Cash_In",
        "Cash_Out",
        "Peer_Transfer",
        "Merchant_Payment",
        "Bill_Payment",
        "Wallet_Top_Up",
        "Refund"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Economic purpose of the transaction. Cash_Out and Peer_Transfer carry highest fraud exposure. Bill_Payment is lowest fraud risk. Refund transactions should be reconciled against originating transaction.",
        "reversal_risk_ranking": "Cash_Out > Peer_Transfer > Cash_In > Merchant_Payment > Bill_Payment > Wallet_Top_Up > Refund"
      }
    },
    "fact_transactions_transaction_status": {
      "column_name": "fact_transactions_transaction_status",
      "table_name": "fact",
      "values": [
        "Completed",
        "Failed",
        "Pending",
        "Reversed",
        "Disputed",
        "Blocked",
        "Expired"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Terminal or in-flight status of the transaction. Reversed and Disputed are primary loss indicators. Blocked transactions were stopped by real-time fraud rules. Expired applies to USSD sessions that timed out.",
        "loss_relevant": [
          "Reversed",
          "Disputed",
          "Failed"
        ]
      }
    },
    "fact_transactions_fraud_flag": {
      "column_name": "fact_transactions_fraud_flag",
      "table_name": "fact",
      "values": [
        "Confirmed_Fraud",
        "Suspected_Fraud",
        "Cleared",
        "Not_Reviewed"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Fraud classification outcome. Confirmed_Fraud means investigated and confirmed. Suspected_Fraud is rule-triggered but pending review. Cleared means investigated and found legitimate. Not_Reviewed means below review threshold."
      }
    },
    "fact_transactions_dispute_reason": {
      "column_name": "fact_transactions_dispute_reason",
      "table_name": "fact",
      "values": [
        "Unauthorized_Transaction",
        "Duplicate_Transaction",
        "Service_Not_Received",
        "Wrong_Amount",
        "Wrong_Recipient",
        "Network_Failure_Debit",
        "Agent_Error",
        "Account_Compromise",
        "Other"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Worker-reported reason for raising a dispute. Agent_Error is disproportionately high in Kenya agent network. Account_Compromise and Unauthorized_Transaction are direct fraud indicators.",
        "fraud_correlated": [
          "Unauthorized_Transaction",
          "Account_Compromise",
          "Duplicate_Transaction"
        ]
      }
    },

    "dim_date_is_holiday": {
      "column_name": "dim_date_is_holiday",
      "table_name": "dim",
      "values": [
        "Yes",
        "No"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Whether the date is a public holiday in the transaction's originating market. Holiday periods correlate with elevated Cash_Out fraud."
      }
    },
    "dim_date_market_trading_session": {
      "column_name": "dim_date_market_trading_session",
      "table_name": "dim",
      "values": [
        "Pre_Market",
        "Peak_Morning",
        "Midday",
        "Peak_Evening",
        "Late_Night",
        "Off_Hours"
      ],
      "hierarchy": null,
      "metadata": {
        "description": "Time-of-day session bucket based on local market time. Late_Night transactions on USSD and Agent channels are a leading fraud indicator.",
        "fraud_risk_ranking": "Late_Night > Off_Hours > Peak_Evening > Pre_Market > Midday > Peak_Morning"
      }

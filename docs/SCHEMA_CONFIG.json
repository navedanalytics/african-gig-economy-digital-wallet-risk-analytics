      "hierarchy": null,
      "metadata": {
        "description": "Four active PayPesa markets. Each market has distinct channel mix and regulatory regime.",
        "notes": "Nigeria: bank-transfer dominant; Kenya: mobile-money agent dominant; Ghana: mixed; South Africa: card and bank-transfer dominant"
      }

9"/><column index="28" value="143"/><column index="29" value="64"/><column index="30" value="95"/><column index="31" value="59"/><column index="32" value="167"/><column index="33" value="127"/><column index="34" value="167"/><column index="35" value="59"/><column index="36" value="97"/><column index="37" value="108"/><column index="38" value="103"/><column index="39" value="58"/><column index="40" value="91"/><column index="41" value="151"/><column index="42" value="143"/><column index="43" value="95"/><column index="44" value="125"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">select sum(amount_usd) as total_transaction_value
from merged_table;


select sum(fraud_loss_usd) as total_transaction_value
from merged_table;


select avg(fraud_loss_usd )
from merged_table;



SELECT 
    SUM(CASE 
            WHEN is_fraud_flagged = 'True' THEN 1 
            ELSE 0 
        END) * 100.0 / COUNT(is_fraud_flagged ) AS fraud_rate
FROM merged_table;



SELECT
    SUM(CASE 
            WHEN is_fraud_flagged = 'True' THEN 1 
            ELSE 0 
        END) AS fraudulent_transactions,
    COUNT(*) AS total_transactions,
    SUM(CASE 
            WHEN is_fraud_flagged = 'True' THEN 1 
            ELSE 0 
        END) * 100.0 / COUNT(*) AS fraud_rate
FROM merged_table;





select sum(case when transaction_outcome='Completed' then 1 else 0 end) as completed_transactions,
count(*) as total_transactions,round(sum(case when transaction_outcome='Completed' then 1 else 0 end) *100.0 / count(*),2) as completion_rate
from merged_table;





select month,count(transaction_id) as total_monthly_transactions,round(sum(fraud_loss_usd),2) as monthly_fraud_loss
from merged_table
group by month;




select transaction_outcome ,count(*) as total_transaction,round(count(*) *100.0/ sum(count(*)) over(),2)as transactionpercentage
from merged_table
group by transaction_outcome;





select country,round(sum(amount_usd),2) as total_revenue , round(sum(fraud_loss_usd),2) as total_fraud_loss
from merged_table
group by country;

select channel_type,round(avg(processing_time_ms),2) as avg_processing_time,(select round(avg(processing_time_ms),2) from merged_table) as avg_processing_time_
from merged_table	
group by channel_type
order by avg_processing_time desc;



select distinct month
from merged_table;











</sql><current_tab id="0"/></tab_sql></sqlb_project>
